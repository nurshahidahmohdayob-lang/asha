rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        // Any signed-in staff member on the school domain is an admin.
        request.auth.token.get('email', '').lower().matches('.*@zera[.]edu[.]my') ||
        request.auth.token.get('email', '').lower() == 'nurshahidahmohdayob@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roles', []).hasAny(['admin']))
      );
    }

    // Head of Department / Coordinator review lesson plan submissions.
    function isReviewer() {
      return isAdmin() || (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roles', []).hasAny(['hod', 'coordinator'])
      );
    }

    // --- Entities ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'teacherName', 'roles', 'createdAt']) &&
             data.keys().size() == 5 &&
             data.uid is string && (data.uid == request.auth.uid || isAdmin()) &&
             data.email is string && data.email.size() <= 200 &&
             data.teacherName is string && data.teacherName.size() <= 100 &&
             data.roles is list &&
             data.createdAt is string;
    }

    function isValidProject(data) {
      return data.keys().hasAll(['id', 'userId', 'timestamp', 'title', 'category', 'status', 'content']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId is string && (data.userId == request.auth.uid || isAdmin()) &&
             data.timestamp is number &&
             data.title is string && data.title.size() <= 500 &&
             data.category in ['lesson-plan', 'worksheet', 'slides', 'poster', 'all', 'notes', 'journal'] &&
             data.status in ['draft', 'submitted'] &&
             data.content is map &&
             (!data.keys().hasAny(['folderId']) || data.folderId == null || (data.folderId is string && data.folderId.size() <= 128)) &&
             (!data.keys().hasAny(['teacherName']) || data.teacherName == null || (data.teacherName is string && data.teacherName.size() <= 200)) &&
             (!data.keys().hasAny(['settings']) || data.settings is map);
    }

    function isValidFolder(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'timestamp']) &&
             data.keys().size() == 4 &&
             data.id is string && data.id.size() <= 128 &&
             data.userId is string && (data.userId == request.auth.uid || isAdmin()) &&
             data.name is string && data.name.size() <= 200 &&
             data.timestamp is number;
    }

    function isValidTimetable(data) {
      return data.keys().hasAll(['staffAssignments', 'assignmentQuotas', 'timetableGrid', 'updatedAt']) &&
             data.staffAssignments is map &&
             data.assignmentQuotas is list &&
             data.timetableGrid is map &&
             data.updatedAt is number;
    }

    function isValidCovers(data) {
      return data.keys().hasAll(['records', 'updatedAt']) &&
             data.records is list &&
             data.updatedAt is number;
    }

    // --- Matches ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if (isOwner(userId) || isAdmin()) && isValidUser(incoming()) && 
                    incoming().uid == existing().uid && 
                    incoming().email == existing().email;
      allow delete: if isAdmin();
    }

    match /submitted_plans/{planId} {
      allow get: if isReviewer() || (isSignedIn() && existing().userId == request.auth.uid);
      allow list: if isReviewer() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      // Reviewers move a plan through the approval flow; the teacher who owns
      // it updates their own submission when they fix and resubmit.
      allow update: if isReviewer() || (isSignedIn() && existing().userId == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    match /submitted_folders/{folderId} {
      allow read, list, write: if isAdmin();
    }

    // A teacher's professional development record, one document per teacher,
    // keyed by uid. Theirs to write; a Head of Department or coordinator needs
    // to read it to sign off training hours, and admin can list them all for a
    // whole-school return.
    match /professional_development/{userId} {
      allow get: if isOwner(userId) || isReviewer() || isAdmin();
      allow list: if isReviewer() || isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /projects/{projectId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidProject(incoming());
      allow update: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin()) && isValidProject(incoming()) &&
                    incoming().id == existing().id &&
                    incoming().userId == existing().userId;
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    match /folders/{folderId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidFolder(incoming());
      allow update: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin()) && isValidFolder(incoming()) &&
                    incoming().id == existing().id &&
                    incoming().userId == existing().userId;
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    match /school_config/timetable {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidTimetable(incoming());
    }

    match /school_config/covers {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidCovers(incoming());
    }

    match /system/connection_test {
      allow get: if true;
    }
  }
}
