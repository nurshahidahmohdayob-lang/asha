# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=
APP_URL=

# Staff Management API Configuration
# Base URL for the school portal API (e.g., https://zera-education.commun.cloud)
STAFF_API_BASE_URL=
# Laravel Sanctum token for authenticating staff read operations (e.g., 23|IUgdvUd...)
STAFF_API_KEY=

# Passwordless Authentication SMTP Configuration
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Supabase (data). The anon key is public by design; RLS guards the tables.
SUPABASE_URL=
SUPABASE_ANON_KEY=
