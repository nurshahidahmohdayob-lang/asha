# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=
APP_URL=

# Staff Management API Configuration
# Base URL for the school portal API (e.g., https://zera-education.commun.cloud)
STAFF_API_BASE_URL=
# Laravel Sanctum token for authenticating staff read operations (e.g., 23|IUgdvUd...)
STAFF_API_KEY=

# Passwordless Authentication SMTP Configuration
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Supabase (data). The anon key is public by design; RLS guards the tables.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SERVER ONLY. Never prefix with VITE_ and never expose to the browser —
# it bypasses every access rule. Used solely by server/data-api.ts.
SUPABASE_SERVICE_ROLE_KEY=
# SERVER ONLY. The Postgres connection string, used by scripts/migrate.mjs to
# apply supabase/migrations on every build. Dashboard → Project Settings →
# Database → Connection string → URI, using the DIRECT connection (port 5432),
# not the transaction pooler (6543).
#
# Deliberately NOT called DATABASE_URL: that name already means "use MySQL
# instead of Supabase" to server/db-driver.ts and would switch the whole app
# over. Leave blank and builds still work — migrations are skipped with a
# warning, which is what a front-end build with no database password wants.
SUPABASE_DB_URL=

# ── Commun Connected Systems: single sign-on for teachers ────────────────
# Registered by a school administrator in the Commun school portal under
# School Admin → Connected Systems. The callback URL there is an allowlist of
# exactly one and must match the deployment exactly.
COMMUN_SCHOOL_URL=https://zera-education.commun.cloud
COMMUN_CLIENT_ID=
# The iss claim on a ticket. Commun stamps the PLATFORM root (https://commun.cloud),
# NOT the school subdomain, despite the vendor docs calling it "the school's app
# URL". Leave blank to expect the school URL; set it when a ticket says otherwise
# — the log names both values on a mismatch.
COMMUN_ISSUER=https://commun.cloud
# SERVER ONLY. The machine token for back-channel reads (/api/v1/userinfo).
# Shown once at registration; the administrator rotates the system to reissue.
COMMUN_MACHINE_TOKEN=
# Informational — what /api/sso/status reports as the registered callback.
COMMUN_SSO_CALLBACK_URL=https://zeraeducationsuite.vercel.app/auth/callback

# Firebase service account, used ONLY to mint a sign-in token once an SSO
# ticket has verified. SERVER ONLY — it can sign in as any teacher.
# Either paste the whole service-account.json on one line...
FIREBASE_SERVICE_ACCOUNT=
# ...or set these two instead. Newlines in the key may be written as \n.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
