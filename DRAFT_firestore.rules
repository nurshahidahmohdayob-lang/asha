rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isEmailVerified() {
      // Mandating verified email if possible, but for initial registration we might not want to block immediately.
      // However, the prompt implies "secure" so let's check it if we can. 
      // For now, simple auth check is usually enough unless user specifically asks for strict verification.
      return isSignedIn();
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entities ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'teacherName', 'createdAt']) &&
             data.keys().size() == 4 &&
             data.uid is string && data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 200 &&
             data.teacherName is string && data.teacherName.size() <= 100 &&
             data.createdAt is string;
    }

    function isValidProject(data) {
      return data.keys().hasAll(['id', 'userId', 'timestamp', 'title', 'category', 'status', 'content']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.timestamp is number &&
             data.title is string && data.title.size() <= 500 &&
             data.category in ['lesson-plan', 'worksheet', 'slides', 'poster', 'all'] &&
             data.status in ['draft', 'submitted'] &&
             data.content is map;
    }

    // --- Matches ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && 
                    incoming().uid == existing().uid && 
                    incoming().email == existing().email;
    }

    match /projects/{projectId} {
      allow get: if isSignedIn() && isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidProject(incoming());
      allow update: if isSignedIn() && isOwner(existing().userId) && isValidProject(incoming()) &&
                    incoming().id == existing().id &&
                    incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }
  }
}
